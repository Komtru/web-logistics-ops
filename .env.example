# ---------------------------------------------------------------------------
# Komtru Logistics Ops — environment template.
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Backend origin + version prefix. All browser traffic goes to same-origin
# `/api/...` and is rewritten here by next.config.ts.
NEXT_PUBLIC_BASE_URL=http://localhost:7831/v1

# Public origin of this app. Drives `metadataBase`.
NEXT_PUBLIC_APP_URL=http://localhost:7830

# Origin of the Socket.IO gateway — the backend host itself, with no `/v1`
# prefix and no `/api` rewrite in front of it: a WebSocket upgrade needs to
# reach the persistent backend process directly. The backend's
# `SOCKET_CORS_ORIGINS` must list NEXT_PUBLIC_APP_URL for the handshake to be
# accepted. Leave blank to run the console with realtime switched off.
NEXT_PUBLIC_SOCKET_URL=http://localhost:7831
